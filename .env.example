APP_NAME="MI Preview"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.mius.it.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=miusofrv_preview
DB_USERNAME=miusofrv_preview
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# host-only: the admin session lives on app.{base} only
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- MI Preview -------------------------------------------------------------
# locally: localhost
PREVIEW_BASE_DOMAIN=mius.it.com
PREVIEW_ADMIN_SUBDOMAIN=app
PREVIEW_BRAND_NAME="MI Web Development"
# my own WhatsApp number (digits, intl format), used in the demo bar
PREVIEW_BRAND_WHATSAPP=
PREVIEW_LEGAL_EMAIL=privacy@mius.it.com
# owner-exclusion cookie domain (defaults to .{PREVIEW_BASE_DOMAIN})
OWNER_COOKIE_DOMAIN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=901743307
# phase 2 — stock photos (Pixabay key: free & instant at https://pixabay.com/api/docs/)
PIXABAY_API_KEY=
PEXELS_API_KEY=
# optional: logo background removal fallback (https://www.remove.bg/api)
REMOVE_BG_API_KEY=
# Meta Graph API — Facebook Pages and Instagram Business Discovery
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
# optional: META_GRAPH_VERSION=v27.0
# optional: META_MAX_POSTS=36 (12–60)
# phase 3 — AI content (Anthropic API key from https://console.anthropic.com)
AI_API_KEY=
# optional: AI_MODEL=claude-opus-5-5 (stronger, ~2x price), AI_EFFORT=low|medium|high
# Google Gemini (free tier: https://aistudio.google.com/apikey) — both can be set, pick per run
GEMINI_API_KEY=
# optional: GEMINI_MODEL=gemini-3.6-flash (default, stable), AI_PROVIDER=claude|gemini (default choice)

# single seeded admin user (php artisan db:seed --class=AdminUserSeeder)
ADMIN_EMAIL=
ADMIN_PASSWORD=
